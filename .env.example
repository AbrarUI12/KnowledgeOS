# KnowledgeOS local development environment.
# Copy to `.env` (git-ignored): `cp .env.example .env`. These values are for LOCAL DEVELOPMENT ONLY.
# Staging/production secrets live in each platform's secret store, never in git.

# --- PostgreSQL (docker compose) -------------------------------------------
POSTGRES_PORT=5433
POSTGRES_DB=knowledgeos
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
KOS_OWNER_PASSWORD=owner_dev_password
KOS_APP_PASSWORD=app_dev_password
KOS_DISPATCHER_PASSWORD=dispatcher_dev_password
KEYCLOAK_DB_PASSWORD=keycloak_dev_password

# Runtime connection (RLS applies: knowledgeos_app has NOBYPASSRLS and owns no tables)
DATABASE_URL=postgresql+asyncpg://knowledgeos_app:app_dev_password@localhost:5433/knowledgeos
# Migrations connect as the schema owner
DATABASE_MIGRATION_URL=postgresql+asyncpg://knowledgeos_owner:owner_dev_password@localhost:5433/knowledgeos

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# --- Object storage (MinIO locally; Backblaze B2 / R2 when deployed) -------------
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
# Endpoint used inside presigned URLs (must be reachable by the browser)
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=kos_minio
S3_SECRET_ACCESS_KEY=kos_minio_dev_secret
S3_BUCKET_QUARANTINE=kos-quarantine
S3_BUCKET_TRUSTED=kos-trusted
S3_BUCKET_ARTIFACTS=kos-artifacts
S3_FORCE_PATH_STYLE=true
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=30
# Total attempts including the first (standard retry mode)
S3_MAX_ATTEMPTS=3

# --- Identity (Keycloak locally; Auth0 when deployed) ---------------------------
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_ISSUER=http://localhost:8080/realms/knowledgeos
OIDC_AUDIENCE=knowledgeos-api
OIDC_JWKS_URL=http://localhost:8080/realms/knowledgeos/protocol/openid-connect/certs
OIDC_WEB_CLIENT_ID=knowledgeos-web
OIDC_WEB_CLIENT_SECRET=knowledgeos-web-dev-secret
OIDC_CLI_CLIENT_ID=knowledgeos-cli

# --- Email (Mailpit) ------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Malware scanning (ClamAV, `full` profile) ---------------------------------------
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
CLAMAV_MAX_STREAM_BYTES=52428800
# Local development may opt out; staging and production default to true.
REQUIRE_MALWARE_SCAN=false

# --- Web ------------------------------------------------------------------------
AUTH_URL=http://localhost:3000
# Generate a private random secret (at least 32 bytes) for Auth.js encrypted cookies.
AUTH_SECRET=
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
# All agents' dev web origins (API + MinIO CORS; Keycloak allows the same ports). Exact origins only.
WEB_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:3200

# Organizations (T1.3)
WEB_BASE_URL=http://localhost:3000
INVITATION_TTL_HOURS=168
IDEMPOTENCY_TTL_HOURS=24

# Uploads (T2.4)
UPLOAD_MAX_BYTES=52428800
UPLOAD_URL_TTL_SECONDS=900

# Background work (T3.1)
DISPATCHER_DATABASE_URL=postgresql+asyncpg://knowledgeos_dispatcher:dispatcher_dev_password@localhost:5433/knowledgeos
INGESTION_LEASE_SECONDS=300
INGESTION_MAX_ATTEMPTS=5

# Ingestion (T3.5): clamav needs the `full` profile; use none with `make up` (core)
MALWARE_SCANNER=clamav

# Embeddings (T4.2): recorded on each new KB's index generation; never substituted.
# Local dev without the model library indexes full text only; staging/prod require vectors.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DEVICE=cpu
# openai_compatible only: EMBEDDING_BASE_URL, EMBEDDING_API_KEY, EMBEDDING_IS_EXTERNAL
# Model cache (Compose mounts a volume at /models/hf); HF_TOKEN is optional
# HF_HOME=
# HF_TOKEN=

# T5.2 DB-free generation config (orchestration wiring belongs to T5.3).
# Explicit models; external quotas must match the account's actual free-tier limits.
# Set OLLAMA_NO_CLOUD=1 on the SERVER for a local-only deployment.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b
OLLAMA_RPM=60
OLLAMA_TPM=60000
OLLAMA_RPD=10000
GROQ_API_KEY=
GROQ_MODEL=
GROQ_RPM=
GROQ_TPM=
GROQ_RPD=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_RPM=
GEMINI_TPM=
GEMINI_RPD=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_RPM=
OPENROUTER_TPM=
OPENROUTER_RPD=
# Optional <PROVIDER>_BASE_URL overrides and <PROVIDER>_QUOTA_GROUP (non-secret account label).
# Processes/models sharing an account must use the same quota group and limits.
