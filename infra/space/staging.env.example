# Hugging Face Space configuration for staging (S32/S33). NAMES ONLY in git: put every value
# marked (secret) into Space "Secrets", the rest into Space "Variables". For `make space-smoke`,
# copy this file to `.env.staging` at the repo root (git-ignored) and fill it in locally.
# The image already sets: ENVIRONMENT=staging, REDIS_URL, MALWARE_SCANNER=clamav, CLAMAV_*,
# EMBEDDING_PROVIDER/DEVICE, RERANKER_*, DOCLING_*, HF_HUB_OFFLINE.

# Neon (direct connection strings, SSL required): postgresql+asyncpg://ROLE:PASSWORD@HOST/DB?ssl=require
# DATABASE_URL: (secret) knowledgeos_app
DATABASE_URL=
# DATABASE_MIGRATION_URL: (secret) knowledgeos_owner
DATABASE_MIGRATION_URL=
# DISPATCHER_DATABASE_URL: (secret) knowledgeos_dispatcher
DISPATCHER_DATABASE_URL=

# Backblaze B2 (S3 API): endpoint https://s3.<region>.backblazeb2.com
S3_ENDPOINT_URL=
# S3_PUBLIC_ENDPOINT_URL: same as S3_ENDPOINT_URL for B2
S3_PUBLIC_ENDPOINT_URL=
# S3_REGION: e.g. us-west-004
S3_REGION=
# S3_ACCESS_KEY_ID: (secret) application key id scoped to the three buckets
S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY: (secret)
S3_SECRET_ACCESS_KEY=
S3_BUCKET_QUARANTINE=kos-staging-quarantine
S3_BUCKET_TRUSTED=kos-staging-trusted
S3_BUCKET_ARTIFACTS=kos-staging-artifacts

# Auth0 (issuer has a trailing slash): https://<tenant>.<region>.auth0.com/
OIDC_ISSUER=
# OIDC_AUDIENCE: the Auth0 API identifier
OIDC_AUDIENCE=

# Browser origins allowed by CORS (the Vercel staging URL, comma-separated, exact)
WEB_ORIGINS=

# Generation: Groq primary, Gemini fallback; evidence leaves the deployment (demo data only)
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDERS=gemini
LLM_ALLOW_EXTERNAL=true
# GROQ_API_KEY: (secret)
GROQ_API_KEY=
# GROQ_MODEL: e.g. a current Groq Llama model id
GROQ_MODEL=
# GROQ_RPM: your account's actual free-tier limits
GROQ_RPM=
GROQ_TPM=
GROQ_RPD=
# GEMINI_API_KEY: (secret)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_RPM=
GEMINI_TPM=
GEMINI_RPD=
